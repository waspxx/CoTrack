# CoTrack Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.

# --- Google Gemini AI API Configuration ---
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Primary and Fallback Models
GEMINI_MODEL_PRIMARY="gemini-3.7-flash"
GEMINI_MODEL_FALLBACK="gemini-3.5-flash-lite"

# --- Flask Configuration ---
# Set a unique, secure random string for session signing (e.g. generate via python: secrets.token_hex(32))
SECRET_KEY="YOUR_FLASK_SECRET_KEY"

# --- SMTP Configuration (Optional, for Weekly Email Reports) ---
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
# For Gmail, use a 16-character App Password (not your main password)
SMTP_PASSWORD="your_smtp_app_password"
MAIL_DEFAULT_SENDER="your_email@gmail.com"

# --- Drivvo Auto-Sync Configuration (Optional) ---
# Automatically synchronizes vehicle activities (refuelings, expenses, maintenance, incomes, reminders) to Drivvo
DRIVVO_ENABLED="true"
DRIVVO_EMAIL="your_drivvo_email@example.com"
DRIVVO_PASSWORD="your_drivvo_password"
